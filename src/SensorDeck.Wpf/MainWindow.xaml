<Window x:Class="SensorDeck.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="SensorDeck" Height="600" Width="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Connect"
                    Command="{Binding ConnectCommand}"
                    Padding="12,4" />
            <Ellipse Width="14" Height="14" Margin="16,0,6,0" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="IndianRed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Fill" Value="MediumSeaGreen" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Live readouts -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,0,0,12">
            <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Temperature (°C)" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding CurrentTemperature, StringFormat={}{0:F2}}" FontSize="28" />
                </StackPanel>
            </Border>
            <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Voltage (V)" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding CurrentVoltage, StringFormat={}{0:F3}}" FontSize="28" />
                </StackPanel>
            </Border>
            <Border BorderBrush="Gray" BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="Vibration (g)" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding CurrentVibration, StringFormat={}{0:F3}}" FontSize="28" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Scrolling temperature chart -->
        <lvc:CartesianChart Grid.Row="2" Series="{Binding TemperatureSeries}" Margin="0,0,0,12" />

        <!-- Outbound commands -->
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button Content="Toggle Heater"
                    Command="{Binding ToggleHeaterCommand}"
                    Padding="12,4" />
            <TextBlock Text="Heater:" Margin="16,0,4,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding HeaterOn}" VerticalAlignment="Center" Margin="0,0,16,0" />

            <TextBlock Text="Sample rate (ms):" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Slider Minimum="20" Maximum="1000" Width="180" VerticalAlignment="Center"
                    Value="{Binding SampleRateMs}" />
            <TextBlock Text="{Binding SampleRateMs, StringFormat={}{0:F0}}" VerticalAlignment="Center" Margin="8,0" />
            <Button Content="Apply" Command="{Binding ApplySampleRateCommand}" Padding="12,4" />
        </StackPanel>
    </Grid>
</Window>
